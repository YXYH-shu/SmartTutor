# ============================================================
# Smart Tutor v2 环境变量配置
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# ============================================================

# ── LLM 配置（智谱 GLM，OpenAI Chat Completions 兼容）──────────
SMART_TUTOR_LLM__PROVIDER=glm
SMART_TUTOR_LLM__BASE_URL=https://open.bigmodel.cn/api/paas/v4
SMART_TUTOR_LLM__API_KEY=你的智谱API密钥
SMART_TUTOR_LLM__MODEL_NAME=glm-5
SMART_TUTOR_LLM__MAX_RETRIES=3
SMART_TUTOR_LLM__TIMEOUT=60
# 是否显式传 thinking extra_body。glm-5 默认就会 reasoning,默认 false 即可。
SMART_TUTOR_LLM__ENABLE_THINKING=false
# 全局滑动窗口限流（60s）。0 = 不限。
# 智谱 GLM-5 触发配额会返回 HTTP 429 / 错误码 1113，stage_executor 单轮
# 会触发 5+ 个 agent × 多次重试，连续 2-3 轮容易把限额打满。
# 默认 rpm=10 / tpm=40000 偏保守；额度充足可以调高或设 0 关闭。
SMART_TUTOR_LLM__RATE_LIMIT_RPM=10
SMART_TUTOR_LLM__RATE_LIMIT_TPM=40000

# ── 数据库 ────────────────────────────────────────────────────
# 本地开发默认使用 SQLite，不需要单独启动数据库。
SMART_TUTOR_DATABASE__URL=sqlite+aiosqlite:///./smart_tutor.db
SMART_TUTOR_DATABASE__ECHO=false

# 如需切换 MySQL，可改为：
# SMART_TUTOR_DATABASE__URL=mysql+aiomysql://tutor:tutor123@localhost:3306/smart_tutor

# ── 应用 ──────────────────────────────────────────────────────
SMART_TUTOR_APP__DEBUG=true
SMART_TUTOR_APP__SECRET_KEY=change-me-in-production-32chars!!
SMART_TUTOR_APP__JWT_EXPIRATION=86400

# ── LangGraph 检查点 ──────────────────────────────────────────
SMART_TUTOR_LANGGRAPH__CHECKPOINT_TYPE=memory
# SMART_TUTOR_LANGGRAPH__CHECKPOINT_POSTGRES_URL=postgresql+psycopg://tutor:tutor123@localhost:5432/smart_tutor_checkpoint

# ── KT (知识追踪) 集成 ────────────────────────────────────────
# mode:
#   off        cognitive_diagnosis 走纯 LLM 模拟
#   integrated cognitive_diagnosis 调用 services/kt-runtime-skill 拿真实掌握度
#              (默认;需要 torch,启动稍慢;LLM 仅做认知归因,数值不会幻觉)
#   standalone KT 走 PR #1 原方案 — services/chat-agent 独立服务 + 前端 iframe
#              (此模式下 cognitive_diagnosis 行为同 off,需要额外启动 chat-agent 服务)
SMART_TUTOR_KT__MODE=integrated
# kt-runtime-skill 路径,默认相对仓库根目录
SMART_TUTOR_KT__SKILL_PATH=services/kt-runtime-skill
# KT 模型运行设备(cuda:0 / cpu),无 GPU 环境改为 cpu
SMART_TUTOR_KT__DEVICE=cuda:0
# 默认预测目标 kp_id,逗号分隔;留空则用 kt config 内部全部
SMART_TUTOR_KT__DEFAULT_TARGETS=
# 用户画像映射或请求中的数字学生编号优先；缺失时使用内置数据集学生 43
SMART_TUTOR_KT__DEMO_STUDENT_ID=43
SMART_TUTOR_KT__TIMEOUT_SECONDS=180
# KT 调用失败时是否降级到纯 LLM
SMART_TUTOR_KT__FALLBACK_TO_LLM=false

# ── LPP (学习路径规划) Skill 集成 ─────────────────────────────
SMART_TUTOR_LPP__ENABLED=true
SMART_TUTOR_LPP__SKILL_PATH=services/lpp-skill
SMART_TUTOR_LPP__TIMEOUT_SECONDS=120
SMART_TUTOR_LPP__CPU_THREADS=1
SMART_TUTOR_LPP__HISTORY_LENGTH=10
SMART_TUTOR_LPP__SEED=42

# ── Graph Recommender ────────────────────────────────────────────
# `EMBEDDING_MODEL_ID` accepts either a Hugging Face model name or a local model directory.
# `CHECKPOINT_DIR` is relative to backend/ unless an absolute path is provided.
SMART_TUTOR_GRAPH_RECOMMENDER__ENABLED=true
SMART_TUTOR_GRAPH_RECOMMENDER__EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
SMART_TUTOR_GRAPH_RECOMMENDER__CHECKPOINT_DIR=algorithm/graph_recommender/ckpt
