# 后端 API 地址(留空则使用相对路径 /api,适合前端和后端同域部署或通过 Vite 代理)
VITE_API_URL=

# KT 集成模式开关
#   false (默认,integrated 模式): KT 直接集成在主对话流里,不显示侧边栏 iframe 入口
#   true       (standalone 模式): 显示侧边栏"学情分析"按钮,点击进入 iframe 嵌入的 ChatAgent
VITE_KT_STANDALONE=false

# standalone 模式下,ChatAgent 子服务的地址(services/chat-agent 启动后的端口)
VITE_KT_CHATAGENT_URL=http://127.0.0.1:8910/
